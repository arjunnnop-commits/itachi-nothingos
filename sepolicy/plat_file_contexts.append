# POCO X6 Pro (Duchamp) AOD Daemon & Init Service
/system/bin/itachi_aodd                   u:object_r:shell_exec:s0
/system/etc/init/itachi_aodd\.rc          u:object_r:system_file:s0

/system/bin/duchamp_fod_icon_prepare -- u:object_r:duchamp_fod_icon_exec:s0
/system/etc/init/duchamp[.]fod-icon[.]rc -- u:object_r:system_file:s0
