; One-shot SystemUI icon storage initializer, separate from init and app domains.
(type duchamp_fod_icon)
(roletype r duchamp_fod_icon)
(typeattributeset domain (duchamp_fod_icon))
(typeattributeset coredomain (duchamp_fod_icon))
(typeattributeset mlstrustedsubject (duchamp_fod_icon))
(type duchamp_fod_icon_exec)
(roletype object_r duchamp_fod_icon_exec)
(typeattributeset file_type (duchamp_fod_icon_exec))
(typeattributeset exec_type (duchamp_fod_icon_exec))
(typeattributeset system_file_type (duchamp_fod_icon_exec))
(typetransition init duchamp_fod_icon_exec process duchamp_fod_icon)
(allow init duchamp_fod_icon (process (transition siginh rlimitinh)))
; Standard secure-exec transition: keep AT_SECURE enabled, without audit noise.
(dontaudit init duchamp_fod_icon (process (noatsecure)))
(allow init duchamp_fod_icon_exec (file (read open getattr execute map)))
(allow duchamp_fod_icon init (process (sigchld)))
(allow duchamp_fod_icon init (fd (use)))
(allow duchamp_fod_icon duchamp_fod_icon_exec (file (entrypoint read open getattr execute map)))
(allow duchamp_fod_icon self (capability (chown fowner)))
(allow duchamp_fod_icon null_device (chr_file (read write open getattr ioctl)))
(allow duchamp_fod_icon system_data_root_file (dir (search getattr)))
(allow duchamp_fod_icon system_userdir_file (dir (read open search getattr)))
(allow duchamp_fod_icon system_data_file (dir (read open search getattr)))
(allow duchamp_fod_icon packages_list_file (file (read open getattr)))
(allow duchamp_fod_icon os_data_file (dir (read open search getattr setattr write add_name)))
(allow duchamp_fod_icon os_data_file (file (create read write open getattr setattr relabelfrom relabelto)))
